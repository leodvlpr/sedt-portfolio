---
import "../styles/global.css";
import content from "../data/content.json";
import ContactIcon from "../components/ContactIcon.astro";
import { ICONS } from "../lib/icons";
import { asset, home } from "../lib/asset";

interface Props {
  title?: string;
  description?: string;
}

const { profile } = content;
const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.summary,
} = Astro.props;

/* Una entrada por sección, en el mismo orden en que se montan en
   index.astro, y con el mismo rótulo que su <h2>. Los `href` son también la
   lista de secciones que observa el script del final: si se añade una
   sección hay que añadirla aquí, o se queda fuera del nav Y del indicador de
   sección activa. */
const navLinks = [
  { label: "About", href: "#about" },
  { label: "Experience", href: "#experience" },
  { label: "Projects", href: "#projects" },
  { label: "Technologies", href: "#technologies" },
  { label: "Education", href: "#education" },
  { label: "Contact", href: "#contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link
      rel="icon"
      type="image/png"
      href={asset("logo_lm.png")}
    />
    <link
      rel="apple-touch-icon"
      href={asset("logo_lm.png")}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@700;800&display=swap"
    />

    {/* Applied before first paint so the theme never flashes. */}
    <script is:inline>
      (() => {
        /* Marca que hay JS: sólo entonces el menú móvil se pliega tras la
           hamburguesa. Sin JS los enlaces quedan a la vista. */
        document.documentElement.classList.add("js");
        try {
          const stored = localStorage.getItem("theme");
          const dark =
            stored === "dark" ||
            (stored === null &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
        } catch {
          /* localStorage bloqueado: se queda en modo claro */
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-surface font-sans text-ink antialiased">
    {/* Por debajo de lg (con seis secciones la fila única no entra hasta
        1024px): hamburguesa a la izquierda, logo centrado y conmutador de
        tema a la derecha; las secciones se despliegan debajo. La maqueta
        vive en `.site-nav` de global.css. */}
    <nav class="shell site-nav py-8" data-nav>
      <button
        type="button"
        class="icon-btn nav-burger"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-menu"
        data-nav-toggle
      >
        <ContactIcon paths={ICONS.menu} class="nav-burger__open" />
        <ContactIcon paths={ICONS.x} class="nav-burger__close" />
      </button>

      {/* `home` es la raíz del base; un "/" plano saldría del
          subdirectorio y llevaría a la raíz del dominio. */}
      <a
        href={home}
        class="nav-logo font-display text-xl font-extrabold tracking-tight"
        aria-label="leodvlpr — home"
      >
        <span class="text-ink">leo</span><span class="text-coral"
          >dvlpr</span
        ><span class="text-coral" aria-hidden="true">.</span>
      </a>

      <ul id="nav-menu" class="nav-menu">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="ul" data-nav-link>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      {/* En claro se ve la luna (pulsar = ir a oscuro); en oscuro, el sol
          (pulsar = volver a claro). El icono anuncia el destino, no el
          estado actual. */}
      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle light and dark mode"
        class="icon-btn nav-theme"
      >
        <ContactIcon paths={ICONS.moon} class="dark:hidden" />
        <ContactIcon paths={ICONS.sun} class="hidden dark:block" />
      </button>
    </nav>

    <slot />

    {/* Menú móvil: abre y cierra la lista de secciones. Elegir una sección o
        pulsar Escape lo cierra; en escritorio el botón no se ve y la lista
        está siempre a la vista, así que el estado no importa. */}
    <script>
      const nav = document.querySelector<HTMLElement>("[data-nav]");
      const burger = nav?.querySelector<HTMLButtonElement>("[data-nav-toggle]");

      if (nav && burger) {
        const setOpen = (open: boolean) => {
          nav.toggleAttribute("data-open", open);
          burger.setAttribute("aria-expanded", String(open));
        };

        burger.addEventListener("click", () =>
          setOpen(!nav.hasAttribute("data-open")),
        );

        /* Se cierra antes de que el navegador salte al ancla, así el destino
           se calcula ya sin el menú desplegado empujando la página. */
        for (const link of nav.querySelectorAll("[data-nav-link]")) {
          link.addEventListener("click", () => setOpen(false));
        }

        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape" || !nav.hasAttribute("data-open")) return;
          setOpen(false);
          burger.focus();
        });
      }
    </script>

    {/* Marca en el nav la sección que se está viendo. Sin JS no hay
        indicador, pero los enlaces siguen funcionando: es realce, no
        navegación. */}
    <script>
      const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
      );

      /* El nav es la fuente de la lista de secciones; si un href apunta a un
         id que no existe, esa entrada sencillamente se ignora. */
      const targets = links
        .map((link) => ({
          link,
          section: document.getElementById(
            decodeURIComponent(link.hash.slice(1)),
          ),
        }))
        .filter(
          (entry): entry is { link: HTMLAnchorElement; section: HTMLElement } =>
            entry.section !== null,
        );

      if (targets.length) {
        const onScreen = new Set<Element>();
        let active: HTMLAnchorElement | null = null;

        /* Enlace fijado por un clic. Education y Contact juntas miden menos
           que una ventana, así que llegar a Education ES llegar al final de
           la página: por posición es imposible distinguir "he pulsado
           Education" de "he bajado del todo". Cuando el usuario elige a
           dónde ir, manda su elección hasta que vuelva a mover él la página. */
        let pinned: HTMLAnchorElement | null = null;

        const mark = (next: HTMLAnchorElement | null) => {
          if (next === active) return;
          active?.removeAttribute("aria-current");
          next?.setAttribute("aria-current", "true");
          active = next;
        };

        const atBottom = () =>
          window.innerHeight + window.scrollY >=
          document.documentElement.scrollHeight - 2;

        const pick = () => {
          if (pinned) return;
          /* Al final de la página gana la última sección: Contact es corta y
             nunca llega a cruzar la banda de detección, así que sin esto el
             indicador se quedaría atascado en Technologies. */
          if (atBottom()) {
            mark(targets[targets.length - 1].link);
            return;
          }
          const hit = targets.find((entry) => onScreen.has(entry.section));
          /* Arriba del todo no hay ninguna activa: el hero no es una sección
             del nav y marcar About allí sería mentir. */
          mark(hit ? hit.link : null);
        };

        for (const { link } of targets) {
          link.addEventListener("click", () => {
            pinned = link;
            mark(link);
          });
        }

        /* Se suelta con un gesto real del usuario, no con el evento `scroll`:
           el desplazamiento suave dispara `scroll` él solo y se desfijaría a
           mitad de viaje. */
        for (const gesture of ["wheel", "touchstart", "keydown"] as const) {
          window.addEventListener(
            gesture,
            () => {
              if (!pinned) return;
              pinned = null;
              pick();
            },
            { passive: true },
          );
        }

        /* La banda de detección es una franja fina a un cuarto de la ventana:
           la sección activa es la que la cruza, no la que más píxeles ocupa. */
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) onScreen.add(entry.target);
              else onScreen.delete(entry.target);
            }
            pick();
          },
          { rootMargin: "-25% 0px -65% 0px", threshold: 0 },
        );

        for (const { section } of targets) observer.observe(section);

        /* El observador no se entera de llegar al final de la página si no
           cambia ninguna intersección, así que el scroll lo recomprueba.
           Limitado a un fotograma y sin lecturas de layout salvo atBottom(). */
        let queued = false;
        window.addEventListener(
          "scroll",
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(() => {
              queued = false;
              pick();
            });
          },
          { passive: true },
        );

        pick();
      }
    </script>

    <script is:inline>
      document
        .getElementById("theme-toggle")
        ?.addEventListener("click", () => {
          const isDark = document.documentElement.classList.toggle("dark");
          try {
            localStorage.setItem("theme", isDark ? "dark" : "light");
          } catch {
            /* sin persistencia si localStorage no está disponible */
          }
        });
    </script>
  </body>
</html>
