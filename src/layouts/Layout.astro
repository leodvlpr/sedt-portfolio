---
import "../styles/global.css";
import content from "../data/content.json";
import ContactIcon from "../components/ContactIcon.astro";
import { ICONS } from "../lib/icons";
import { asset, home } from "../lib/asset";

interface Props {
  title?: string;
  description?: string;
}

const { profile } = content;
const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.summary,
} = Astro.props;

const navLinks = [
  { label: "About me", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Contact", href: "#contact" },
];
---

<!doctype html>
<html lang="es" class="scroll-auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link
      rel="icon"
      type="image/png"
      href={asset("logo_lm.png")}
    />
    <link
      rel="apple-touch-icon"
      href={asset("logo_lm.png")}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Poppins:wght@700;800&display=swap"
    />

    {/* Applied before first paint so the theme never flashes. */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const dark =
            stored === "dark" ||
            (stored === null &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
        } catch {
          /* localStorage bloqueado: se queda en modo claro */
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-surface font-sans text-ink antialiased">
    {/* Envuelve en móvil: logo + toggle en la primera fila, enlaces en la
        segunda. En una sola fila los 342px disponibles a 390px de ancho no
        alcanzan y el toggle desbordaba el viewport. */}
    <nav
      class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-4 px-6 py-8 sm:flex-nowrap sm:px-10"
    >
      {/* `home` es la raíz del base; un "/" plano saldría del
          subdirectorio y llevaría a la raíz del dominio. */}
      <a
        href={home}
        class="font-display text-xl font-extrabold tracking-tight"
        aria-label="leodvlpr — inicio"
      >
        <span class="text-ink">leo</span><span class="text-coral"
          >dvlpr</span
        ><span class="text-coral" aria-hidden="true">.</span>
      </a>

      <ul
        class="order-2 flex w-full items-center gap-6 text-sm sm:order-1 sm:ml-auto sm:w-auto sm:gap-8"
      >
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-coral">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      {/* En claro se ve la luna (pulsar = ir a oscuro); en oscuro, el sol
          (pulsar = volver a claro). El icono anuncia el destino, no el
          estado actual. */}
      <button
        type="button"
        id="theme-toggle"
        aria-label="Cambiar entre modo claro y oscuro"
        class="order-1 ml-auto grid h-10 w-10 place-items-center rounded-full border border-coral text-coral hover:bg-coral hover:text-paper sm:order-2 sm:ml-0"
      >
        <ContactIcon paths={ICONS.moon} class="dark:hidden" />
        <ContactIcon paths={ICONS.sun} class="hidden dark:block" />
      </button>
    </nav>

    <div class="mx-auto w-full max-w-5xl px-6 pb-16 sm:px-10">
      <slot />
    </div>

    <script is:inline>
      document
        .getElementById("theme-toggle")
        ?.addEventListener("click", () => {
          const isDark = document.documentElement.classList.toggle("dark");
          try {
            localStorage.setItem("theme", isDark ? "dark" : "light");
          } catch {
            /* sin persistencia si localStorage no está disponible */
          }
        });
    </script>
  </body>
</html>
