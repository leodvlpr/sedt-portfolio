---
import content from "../data/content.json";

/* content.json.profile no tiene `github`. No lo inventamos: se declara como
   opcional y el ícono aparece solo si algún día se añade el campo. */
const profile = content.profile as typeof content.profile & {
  github?: string;
};

/* "I'm [nombre]" en dos pesos: el artículo en regular, el nombre en bold. */
const socials = [
  {
    label: "LinkedIn",
    href: profile.linkedin,
    /* tabler: brand-linkedin */
    paths: [
      "M8 11v5",
      "M8 8v.01",
      "M12 16v-5",
      "M16 16v-3a2 2 0 1 0 -4 0",
      "M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z",
    ],
  },
  {
    label: "GitHub",
    href: profile.github,
    /* tabler: brand-github */
    paths: [
      "M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5",
    ],
  },
].filter((s): s is typeof s & { href: string } => Boolean(s.href));
---

<section class="grid items-center gap-12 py-12 md:grid-cols-2 md:gap-16 md:py-20">
  {/* Columna izquierda */}
  <div>
    <h1 class="font-display text-4xl leading-tight tracking-tight sm:text-5xl">
      <span class="font-normal">I&apos;m</span>{" "}
      <span class="font-extrabold">{profile.name}</span>
    </h1>

    <p class="mt-4 text-lg text-ink/70">{profile.role}</p>
    <p class="mt-1 text-sm text-ink/60">{profile.location}</p>

    <a
      href="#contact"
      class="mt-10 inline-block rounded-full border-2 border-coral px-8 py-3 text-sm font-medium tracking-[0.12em] hover:bg-coral hover:text-paper"
    >
      CONTACT ME
    </a>
  </div>

  {/* Columna derecha: foto en B/N sobre el patrón de franjas */}
  <div class="relative mx-auto w-full max-w-sm md:max-w-none">
    {/* Patrón: tres franjas verticales que sobresalen arriba y abajo.
        Las exteriores usan `ink` (navy en claro, blanco en oscuro) para que
        el patrón se invierta con el tema; la central es coral constante. */}
    <div
      aria-hidden="true"
      class="absolute inset-x-8 -top-6 -bottom-6 flex sm:inset-x-12 sm:-top-8 sm:-bottom-8"
    >
      <div class="flex-1 bg-ink"></div>
      <div class="flex-1 bg-coral"></div>
      <div class="flex-1 bg-ink"></div>
    </div>

    <img
      src="/images/profile_lm.jpeg"
      alt={`Retrato de ${profile.name}`}
      width="661"
      height="675"
      decoding="async"
      class="relative w-full object-cover grayscale"
    />
  </div>
</section>

{/* Barra lateral fija. Oculta bajo lg: en móvil los mismos enlaces viven en
    la sección de contacto, así que no se pierde nada. */}
{
  socials.length > 0 && (
    <aside class="fixed right-0 top-1/2 z-10 hidden -translate-y-1/2 lg:block">
      <ul class="flex flex-col gap-3 pr-4">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="grid h-10 w-10 place-items-center rounded-full border border-coral text-coral hover:bg-coral hover:text-paper"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {s.paths.map((d) => (
                  <path d={d} />
                ))}
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
