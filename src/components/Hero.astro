---
import content from "../data/content.json";
import { contactLinks, mailHref } from "../lib/contactLinks";
import { asset } from "../lib/asset";

const { profile } = content;

/* El nombre se parte en dos líneas apiladas. Sale de profile.name, no está
   escrito a mano: si cambia el dato, cambia el bloque. */
const [firstName, ...restOfName] = profile.name.split(" ");
const lastName = restOfName.join(" ");

/* El enlace secundario del hero reutiliza contactLinks para no duplicar la
   URL de LinkedIn; si algún día no estuviera, sencillamente no se pinta. */
const secondary = contactLinks.find((link) => link.external);
---

{/* El hero es lo único que rompe la rejilla raíl/panel: no tiene costura ni
    título de sección. Es el elemento con el que se gasta toda la audacia. */}
<header class="hero">
  <div class="shell hero__grid">
    <p class="hero__greet wipe" style="--d:140ms;--t:320ms">I&apos;m</p>

    {/* Nombre y regla comparten un contenedor `fit-content`: la regla que
        lidera el barrido mide exactamente lo que la línea más larga del
        nombre, en cualquier tamaño de pantalla. */}
    <div class="hero__title">
      <h1 class="hero__name">
        <span class="wipe" style="--d:160ms;--t:620ms">{firstName}</span>{" "}
        <span class="wipe" style="--d:200ms;--t:680ms">{lastName}</span>
      </h1>
      <span class="hero__rule rule-draw" style="--t:760ms" aria-hidden="true"></span>
    </div>

    {/* El retrato se queda dentro del shell: su canto derecho cae en la
        misma vertical que las cifras, que el panel de cada sección y que el
        pie. Es un recorte sin fondo, en blanco y negro, sobre un panel
        cuadrado que no cambia con el tema. */}
    <figure class="hero__shot wipe" style="--d:420ms;--t:460ms">
      {/* Formas de fondo: viven dentro del panel, detrás del recorte, así que
          no pueden descuadrarse respecto a la foto ni salirse del shell. */}
      <span class="orb orb--halo" aria-hidden="true"></span>
      <span class="orb orb--sun" aria-hidden="true"></span>
      <span class="orb orb--orbit" aria-hidden="true"></span>
      <span class="orb orb--pool" aria-hidden="true"></span>
      <img
        src={asset("images/profile_lm.png")}
        alt={`Portrait of ${profile.name}`}
        width="351"
        height="598"
        fetchpriority="high"
        decoding="async"
      />
    </figure>

    <div class="hero__meta">
      <p class="hero__role wipe" style="--d:520ms;--t:420ms">{profile.role}</p>
      <p class="hero__loc wipe" style="--d:580ms;--t:320ms">{profile.location}</p>
    </div>

    <div class="hero__act wipe" style="--d:640ms;--t:420ms">
      {/* Coral de fondo con texto navy: 5.3:1. En blanco sobre coral serían
          3.1:1, por debajo de AA. El par coral+navy además no se mueve al
          cambiar de tema. */}
      <a href={mailHref} class="hero__cta">Email {firstName}</a>

      {secondary && (
        <a
          href={secondary.href}
          target="_blank"
          rel="noopener noreferrer"
          class="hero__alt ul"
        >
          {secondary.label}
        </a>
      )}
    </div>
  </div>
</header>

<style>
  /* `overflow: hidden` es una red de seguridad contra el scroll lateral si
     algo del hero se sale del shell. */
  .hero {
    position: relative;
    background: var(--color-surface);
    overflow: hidden;
  }

  .hero__grid {
    position: relative;
    padding-top: 1rem;
    padding-bottom: 3rem;
  }

  /* --- Tipografía -------------------------------------------------------- */

  .hero__greet {
    position: relative;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
  }

  .hero__title {
    width: fit-content;
    max-width: 100%;
  }

  /* El bloque de tipografía es una pieza de maquetación, no un titular puesto
     encima de una. "Leonel" y "Mujica" tienen las mismas seis letras, así que
     apilados y muy apretados forman un rectángulo casi exacto. */
  .hero__name {
    position: relative;
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 13vw, 9.75rem);
    font-weight: 800;
    line-height: 0.86;
    letter-spacing: -0.04em;
    color: var(--color-ink);
  }

  .hero__name span {
    display: block;
  }

  .hero__rule {
    position: relative;
    display: block;
    height: 2px;
    margin-top: 2rem;
    background: var(--color-coral);
  }

  /* --- Retrato ----------------------------------------------------------- */

  /* El retrato no cambia con el tema: se fijan aquí los tokens semánticos a
     sus valores claros, y el panel, los trazos y la elipse de suelo heredan
     esos valores en los dos modos. */
  .hero__shot {
    --color-ink: var(--color-navy);
    --color-shade: var(--color-stone);
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 1;
    background: var(--color-shade);
    border-radius: var(--radius-figure) 0 var(--radius-figure) 0;
  }

  /* El PNG está recortado al contorno de la persona (351×598, sin
     reescalar), así que `contain` la ajusta a la altura del panel sin
     margen transparente que la encoja. Apoyada en el canto inferior para que
     no flote; el 92% deja aire sobre la cabeza. Con el panel de escritorio
     (~470px) la foto se pinta por debajo de su tamaño nativo y no pierde
     definición. `position` la pinta por encima de las formas. */
  .hero__shot img {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: block;
    width: 100%;
    height: 92%;
    object-fit: contain;
    object-position: center bottom;
    filter: grayscale(1) contrast(1.04);
  }

  /* Círculos y elipses de fondo. Todo en porcentajes del panel, así que
     escalan con él en cada breakpoint. */
  .orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  /* Aro grande detrás de la cabeza. */
  .orb--halo {
    top: 4%;
    left: 50%;
    width: 78%;
    aspect-ratio: 1;
    translate: -50% 0;
    border: 1px solid color-mix(in srgb, var(--color-ink) 22%, transparent);
  }

  /* Disco coral lleno, arriba a la derecha. */
  .orb--sun {
    top: 9%;
    right: 9%;
    width: 17%;
    aspect-ratio: 1;
    background: var(--color-coral);
  }

  /* Elipse en trazo coral que cruza el torso por detrás, inclinada. */
  .orb--orbit {
    top: 46%;
    left: -12%;
    width: 124%;
    height: 26%;
    rotate: -14deg;
    border: 1px solid var(--color-coral);
  }

  /* Elipse tonal, plana, a ras del suelo. */
  .orb--pool {
    bottom: -6%;
    left: 50%;
    width: 92%;
    height: 16%;
    translate: -50% 0;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
  }

  /* --- Texto de apoyo ---------------------------------------------------- */

  .hero__meta {
    position: relative;
    margin-top: 1.75rem;
  }

  .hero__role {
    font-size: 1.25rem;
    line-height: 1.4;
    color: color-mix(in srgb, var(--color-ink) 75%, transparent);
    /* En una columna el cargo se parte en dos líneas; en escritorio cabe
       entero y se suelta el tope (ver la regla del breakpoint). */
    max-width: 22ch;
  }

  .hero__loc {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
  }

  .hero__act {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.75rem;
    margin-top: 2.5rem;
  }

  /* Radio = "esto se pulsa". Lo estructural va a escuadra; sólo las acciones
     y las fichas de stack llevan curva. */
  .hero__cta {
    display: inline-block;
    border-radius: 9999px;
    background: var(--color-coral);
    color: var(--color-navy);
    padding: 0.8rem 1.9rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .hero__alt {
    font-size: 0.9375rem;
    color: var(--color-ink);
  }

  /* --- Escritorio -------------------------------------------------------- */

  @media (min-width: 900px) {
    .hero__grid {
      display: grid;
      /* La columna del retrato crece con el shell para que el cuadrado
         tenga la altura del bloque de texto: 44% deja al nombre ~410px a
         900px de viewport (mide ~385px) y lo topa en 32rem en pantallas
         grandes. */
      grid-template-columns: minmax(0, 1fr) clamp(20rem, 44%, 32rem);
      /* Las filas van declaradas a propósito: con filas implícitas, la línea
         -1 es la 1 y el `grid-row: 1 / -1` de la foto no abarcaba nada. */
      grid-template-rows: auto auto auto auto;
      column-gap: 3rem;
      align-items: start;
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    /* La columna de texto mide ~410px en el caso más estrecho (900px de
       viewport) y el cargo ocupa unos 350px a 1.25rem, así que entra en una
       sola línea sin necesidad de `nowrap` — que aquí sólo serviría para
       recortarlo en silencio, porque el hero lleva overflow: hidden. */
    .hero__role { max-width: none; }

    .hero__greet { grid-column: 1; grid-row: 1; }
    .hero__title { grid-column: 1; grid-row: 2; }
    .hero__meta  { grid-column: 1; grid-row: 3; }
    .hero__act   { grid-column: 1; grid-row: 4; }

    /* La foto abarca todas las filas, centrada en la altura del bloque de
       texto, y no se sale por los lados: su canto derecho queda alineado con
       el resto de la página. */
    .hero__shot {
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: center;
    }
  }

  /* --- Móvil y tableta --------------------------------------------------- */

  @media (max-width: 899px) {
    /* A una columna el retrato va bajo la regla, a todo el ancho del
       shell. */
    .hero__shot {
      margin-top: 2.5rem;
    }
  }
</style>
