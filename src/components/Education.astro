---
import content from "../data/content.json";
import SectionHeading from "./SectionHeading.astro";

type School = { institution: string; period: string };

const education: School[] = content.education;
---

<section id="education" aria-labelledby="education-title" class="py-14">
  <SectionHeading title="Education" id="education" />

  <ul class="mt-6 flex flex-col gap-4">
    {
      education.map((school) => (
        <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
          <span class="font-medium">{school.institution}</span>
          <span class="text-sm tabular-nums text-ink/60">{school.period}</span>
        </li>
      ))
    }
  </ul>
</section>
