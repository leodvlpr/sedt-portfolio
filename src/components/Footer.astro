---
import content from "../data/content.json";

const { profile } = content;
---

<footer
  class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-12 text-sm"
>
  <span class="text-muted dark:text-bone/50">{profile.name}</span>

  <div class="flex flex-wrap gap-x-6 gap-y-2">
    <a href={`mailto:${profile.email}`} class="text-accent hover:underline">
      {profile.email}
    </a>
    <a
      href={profile.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="text-accent hover:underline"
    >
      LinkedIn
    </a>
  </div>
</footer>
