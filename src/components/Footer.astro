---
import Section from "./Section.astro";
import ContactIcon from "./ContactIcon.astro";
import { contactLinks } from "../lib/contactLinks";
---

{/* Destino de #contact: el enlace del nav. Lee de contactLinks, igual que el
    hero, así que los dos no pueden desincronizarse. Se muestra el rótulo del
    canal, no la dirección. */}
<Section id="contact" title="Contact" as="footer">
  <ul class="channels">
    {
      contactLinks.map((link) => (
        <li>
          <a
            class="channel"
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            <span class="channel__icon">
              <ContactIcon paths={link.paths} />
            </span>
            <span class="channel__label ul">{link.label}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="rights">Leonel Mujica - leodvlpr - All rights reserved © - 2026</p>
</Section>

<style>
  .channels {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 3rem;
  }

  .channel {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-ink);
    font-size: 1.25rem;
  }

  /* Tercer momento de color: la página cierra en coral igual que abre. El
     círculo viene relleno de serie en lugar de perfilado — el acento pesa en
     vez de insinuarse. Icono navy sobre coral: 5.3:1, y el par no se mueve
     al cambiar de tema. */
  .channel__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    background: var(--color-coral);
    color: var(--color-navy);
  }

  /* Como el reposo ya es coral, el hover tiene que ir a otro sitio: pasa a
     tinta, que es el único color que sigue contrastando en los dos temas. */
  .channel:hover .channel__icon,
  .channel:focus-visible .channel__icon {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  @media (prefers-reduced-motion: no-preference) {
    .channel__icon {
      transition:
        background-color 220ms var(--ease),
        color 220ms var(--ease);
    }
  }

  .rights {
    margin-top: 5rem;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
  }
</style>
