---
import SectionHeading from "./SectionHeading.astro";
import ContactIcon from "./ContactIcon.astro";
import { contactLinks } from "../lib/contactLinks";
---

{/* Destino de #contact: el enlace del nav. Mismos canales y mismos iconos
    que la barra lateral — ambos leen de contactLinks, así que no pueden
    desincronizarse. Se muestra el rótulo del canal, no la dirección. */}
<footer id="contact" aria-labelledby="contact-title" class="py-14">
  <SectionHeading title="Contact" id="contact" />

  <ul class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-4">
    {
      contactLinks.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            class="group flex items-center gap-3 hover:text-coral"
          >
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-coral text-coral group-hover:bg-coral group-hover:text-paper">
              <ContactIcon paths={link.paths} />
            </span>
            <span class="border-b-2 border-coral pb-0.5">{link.label}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="mt-16 text-center text-sm text-ink/60">
    Leonel Mujica - leodvlpr - All rights reserved © - 2026
  </p>
</footer>
