---
import content from "../data/content.json";
import Section from "./Section.astro";
import { asset } from "../lib/asset";

/* `video` y `poster` son opcionales: un proyecto sin demo renderiza la ficha
   igual, sólo que sin el bloque del vídeo. */
type Project = {
  name: string;
  description: string;
  stack: string[];
  url: string;
  video?: string;
  poster?: string;
};

const projects: Project[] = content.projects;
---

<Section id="projects" title="Projects">
  <ul class="cards">
    {
      projects.map((project, i) => {
        const videoId = `project-video-${i}`;

        return (
          <li class="card">
            <h3 class="card__name">{project.name}</h3>

            <p class="card__text">{project.description}</p>

            <ul class="chips">
              {project.stack.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            {/* Estado por defecto: miniatura estática. El <video> va al margen
                con preload="none" y hidden, así que al cargar la página no se
                pide ni un byte del mp4; el navegador sólo lo busca cuando el
                usuario le da a reproducir. */}
            {project.video && (
              <div class="demo" data-video-card>
                <button
                  type="button"
                  class="demo__trigger"
                  data-video-play
                  aria-controls={videoId}
                >
                  {project.poster && (
                    <img
                      src={asset(project.poster)}
                      alt=""
                      width="1280"
                      height="682"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <span class="demo__label">Watch the suite run</span>
                </button>

                <video
                  id={videoId}
                  data-video
                  hidden
                  controls
                  preload="none"
                  poster={project.poster ? asset(project.poster) : undefined}
                >
                  <source src={asset(project.video)} type="video/mp4" />
                </video>
              </div>
            )}

            <a
              class="card__link ul"
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              View on GitHub
            </a>
          </li>
        );
      })
    }
  </ul>
</Section>

{/* Revelar, no reproducir: el vídeo aparece con sus controles y es el usuario
    quien pulsa play. Nada se reproduce solo. */}
<script>
  document.querySelectorAll<HTMLElement>("[data-video-card]").forEach((card) => {
    const trigger = card.querySelector<HTMLButtonElement>("[data-video-play]");
    const video = card.querySelector<HTMLVideoElement>("[data-video]");
    if (!trigger || !video) return;

    trigger.addEventListener("click", () => {
      video.hidden = false;
      trigger.hidden = true;
      video.focus();
    });
  });
</script>

<style>
  .cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 44rem;
  }

  /* La única tarjeta de la página, y a escuadra: el radio queda reservado
     para lo que se pulsa. */
  .card {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    padding: 1.5rem;
  }

  /* Misma regla coral que el resto de hovers, aquí sobre el canto superior
     de la ficha. */
  .card::before {
    content: "";
    position: absolute;
    inset-inline: -1px;
    top: -1px;
    height: 2px;
    background: var(--color-coral);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .card:hover::before,
  .card:focus-within::before {
    transform: scaleX(1);
  }

  .card__name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .card__text {
    margin-top: 0.65rem;
    max-width: 62ch;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  /* Las fichas de stack no son interactivas, así que no llevan hover. */
  .chips li {
    border: 1px solid color-mix(in srgb, var(--color-ink) 20%, transparent);
    border-radius: 9999px;
    padding: 0.2rem 0.7rem;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-ink) 70%, transparent);
  }

  .demo {
    margin-top: 1.5rem;
  }

  .demo__trigger {
    display: block;
    width: 100%;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    background: none;
    padding: 0;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .demo__trigger img {
    display: block;
    width: 100%;
  }

  .demo__label {
    display: block;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    padding: 0.6rem 0.85rem;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
  }

  .demo__trigger:hover,
  .demo__trigger:focus-visible {
    border-color: var(--color-coral);
  }

  .demo__trigger:hover .demo__label {
    border-top-color: var(--color-coral);
    color: var(--color-ink);
  }

  .demo video {
    display: block;
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  .card__link {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card::before {
      transition: transform 260ms var(--ease);
    }
  }
</style>
