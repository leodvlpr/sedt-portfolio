---
import content from "../data/content.json";
import Section from "./Section.astro";
import ContactIcon from "./ContactIcon.astro";
import { ICONS } from "../lib/icons";
import { asset } from "../lib/asset";

/* `video` y `poster` son opcionales: un proyecto sin demo renderiza la ficha
   igual, sólo que sin el bloque del vídeo. */
type Project = {
  name: string;
  description: string;
  stack: string[];
  url: string;
  video?: string;
  poster?: string;
};

const projects: Project[] = content.projects;
---

<Section id="projects" title="Projects">
  <ul class="cards">
    {
      projects.map((project, i) => {
        const videoId = `project-video-${i}`;

        return (
          <li class="card">
            <h3 class="card__name">{project.name}</h3>

            <p class="card__text">{project.description}</p>

            <ul class="chips">
              {project.stack.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            {/* Estado por defecto: miniatura estática. El <video> va al margen
                con preload="none" y hidden, así que al cargar la página no se
                pide ni un byte del mp4; el navegador sólo lo busca cuando el
                usuario le da a reproducir. */}
            {project.video && (
              <div class="demo" data-video-card>
                <button
                  type="button"
                  class="demo__trigger"
                  data-video-play
                  aria-controls={videoId}
                  aria-label={`Play the ${project.name} demo`}
                >
                  {project.poster && (
                    <img
                      src={asset(project.poster)}
                      alt=""
                      width="1280"
                      height="682"
                      loading="lazy"
                      decoding="async"
                    />
                  )}

                  <span class="icon-btn demo__play" aria-hidden="true">
                    <ContactIcon paths={ICONS.play} />
                  </span>
                </button>

                <video
                  id={videoId}
                  data-video
                  hidden
                  controls
                  preload="none"
                  poster={project.poster ? asset(project.poster) : undefined}
                >
                  <source src={asset(project.video)} type="video/mp4" />
                </video>
              </div>
            )}

            {/* El rótulo pasa a icono en la esquina inferior derecha. Al no
                quedar texto visible, el nombre accesible lo da aria-label y
                nombra el proyecto, no un genérico "GitHub". */}
            <div class="card__foot">
              <a
                class="icon-btn"
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`View ${project.name} on GitHub`}
              >
                <ContactIcon paths={ICONS.github} />
              </a>
            </div>
          </li>
        );
      })
    }
  </ul>
</Section>

{/* Nada se reproduce solo: el mp4 sigue con preload="none" y no se pide un
    byte hasta que el usuario pulsa el botón de play. A partir de ahí, un solo
    gesto — el clic revela el vídeo Y lo arranca, en vez de obligar a pulsar
    play dos veces. */}
<script>
  document.querySelectorAll<HTMLElement>("[data-video-card]").forEach((card) => {
    const trigger = card.querySelector<HTMLButtonElement>("[data-video-play]");
    const video = card.querySelector<HTMLVideoElement>("[data-video]");
    if (!trigger || !video) return;

    trigger.addEventListener("click", () => {
      video.hidden = false;
      trigger.hidden = true;
      video.focus();
      /* El clic es un gesto del usuario, así que la política de autoplay lo
         permite; aun así play() devuelve una promesa que puede rechazarse
         (códec no soportado, por ejemplo) y sin catch quedaría sin manejar.
         Si falla, el vídeo ya está visible con sus propios controles. */
      void video.play().catch(() => {});
    });
  });
</script>

<style>
  .cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 44rem;
  }

  /* La única tarjeta de la página, y a escuadra: el radio queda reservado
     para lo que se pulsa. */
  .card {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    padding: 1.5rem;
  }

  /* Misma regla coral que el resto de hovers, aquí sobre el canto superior
     de la ficha. */
  .card::before {
    content: "";
    position: absolute;
    inset-inline: -1px;
    top: -1px;
    height: 2px;
    background: var(--color-coral);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .card:hover::before,
  .card:focus-within::before {
    transform: scaleX(1);
  }

  .card__name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .card__text {
    margin-top: 0.65rem;
    max-width: 62ch;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  /* Las fichas de stack no son interactivas, así que no llevan hover. */
  .chips li {
    border: 1px solid color-mix(in srgb, var(--color-ink) 20%, transparent);
    border-radius: 9999px;
    padding: 0.2rem 0.7rem;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-ink) 70%, transparent);
  }

  .demo {
    margin-top: 1.5rem;
  }

  .demo__trigger {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    background: none;
    padding: 0;
    color: inherit;
    cursor: pointer;
  }

  .demo__trigger img {
    display: block;
    width: 100%;
  }

  /* El disco lo da `.icon-btn`; aquí sólo el centrado sobre la miniatura.
     inset + margin auto evita un transform, que chocaría con el sistema de
     movimiento. */
  .demo__play {
    position: absolute;
    inset: 0;
    margin: auto;
    /* Compensa el centro óptico del triángulo. */
    padding-left: 0.15rem;
  }

  .demo__trigger:hover,
  .demo__trigger:focus-visible {
    border-color: var(--color-coral);
  }

  /* El disco es un <span> dentro del botón, así que el hover se escucha en
     el botón y no en el propio disco. */
  .demo__trigger:hover .demo__play,
  .demo__trigger:focus-visible .demo__play {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .demo video {
    display: block;
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  .card__foot {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.5rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card::before {
      transition: transform 260ms var(--ease);
    }
  }
</style>
