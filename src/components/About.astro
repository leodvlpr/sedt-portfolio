---
import content from "../data/content.json";
import SectionHeading from "./SectionHeading.astro";

/* El nuevo Hero ya no muestra el summary (sólo nombre, rol, ubicación y CTA),
   así que profile.summary queda libre para About: contenido real, sin
   duplicarlo ni inventarlo. */
const { summary } = content.profile;
---

<section id="about" aria-labelledby="about-title" class="py-14">
  <SectionHeading title="About" id="about" />

  <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink/70">
    {summary}
  </p>
</section>
