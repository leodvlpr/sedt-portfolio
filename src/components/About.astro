---
import content from "../data/content.json";
import SectionHeading from "./SectionHeading.astro";

/* profile.about son los párrafos de esta sección. profile.summary se mantiene
   aparte porque alimenta la meta description del head, donde este texto sería
   demasiado largo. */
const paragraphs: string[] = content.profile.about;
---

<section id="about" aria-labelledby="about-title" class="py-14">
  <SectionHeading title="About" id="about" />

  <div class="mt-6 flex max-w-2xl flex-col gap-5">
    {
      paragraphs.map((text) => (
        <p class="text-base leading-relaxed text-ink/70">{text}</p>
      ))
    }
  </div>
</section>
