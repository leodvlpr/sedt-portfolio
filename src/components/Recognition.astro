---
import content from "../data/content.json";
import Section from "./Section.astro";

const recognition: string[] = content.recognition;
---

<Section id="recognition" title="Recognition">
  <ul class="items">
    {
      recognition.map((item) => (
        <li>
          <span aria-hidden="true" class="tick" />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 56ch;
  }

  .items li {
    display: flex;
    gap: 1rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-ink) 78%, transparent);
  }

  /* Mismo guion coral que marca la costura de las secciones, a menor escala.
     No es numeración: esta lista no es una secuencia. */
  .tick {
    flex: none;
    width: 1.25rem;
    height: 2px;
    margin-top: 0.8rem;
    background: var(--color-coral);
  }
</style>
