---
import content from "../data/content.json";
import SectionHeading from "./SectionHeading.astro";

const recognition: string[] = content.recognition;
---

<section id="recognition" aria-labelledby="recognition-title" class="py-14">
  <SectionHeading title="Recognition" id="recognition" />

  <ul class="mt-6 flex flex-col gap-4">
    {
      recognition.map((item) => (
        <li class="flex gap-3 text-base leading-relaxed">
          <span aria-hidden="true" class="mt-2.5 h-0.5 w-4 shrink-0 bg-coral" />
          <span class="text-ink/70">{item}</span>
        </li>
      ))
    }
  </ul>
</section>
