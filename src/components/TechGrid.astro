---
import content from "../data/content.json";
import SectionHeading from "./SectionHeading.astro";

/* Etiquetas de presentación para las claves de content.json.technologies.
   Cualquier clave nueva cae al fallback (guiones bajos -> espacios). */
const labels: Record<string, string> = {
  testing_automation: "Testing & Automatización",
  performance: "Performance",
  test_management: "Gestión de pruebas",
  ci_cd: "CI/CD",
};

const groups = Object.entries(content.technologies) as [string, string[]][];

const labelFor = (key: string) => labels[key] ?? key.replace(/_/g, " ");
---

<section id="technologies" aria-labelledby="technologies-title" class="py-14">
  <SectionHeading title="Technologies" id="technologies" />

  <div class="mt-6 flex flex-col gap-8">
    {
      groups.map(([key, items]) => (
        <div>
          <h3 class="text-sm font-medium">{labelFor(key)}</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {items.map((item) => (
              <li class="rounded-xs border border-ink/20 px-2.5 py-1 text-sm text-ink/70">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
