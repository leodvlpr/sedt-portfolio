---
import content from "../data/content.json";
import Section from "./Section.astro";

/* Etiquetas de presentación para las claves de content.json.technologies.
   Cualquier clave nueva cae al fallback (guiones bajos -> espacios). */
const labels: Record<string, string> = {
  testing_automation: "Testing & Automation",
  performance: "Performance",
  test_management: "Test management",
  ci_cd: "CI/CD",
};

const groups = Object.entries(content.technologies) as [string, string[]][];

const labelFor = (key: string) => labels[key] ?? key.replace(/_/g, " ");
---

{/* La sección más densa de la página es también la única con fondo propio:
    el cambio de suelo es lo que le da ritmo al scroll, sin recurrir a una
    banda invertida que en modo oscuro quedaría como un bloque cegador. */}
<Section id="technologies" title="Technologies" tone="shade">
  <div class="stack">
    {
      groups.map(([key, items]) => (
        <div class="group">
          <h3 class="group__name">{labelFor(key)}</h3>
          <ul class="chips">
            {items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .stack {
    display: flex;
    flex-direction: column;
  }

  .group {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }

  .group:first-child {
    padding-top: 0;
  }

  .group:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .group__name {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Sin hover: son etiquetas, no botones. */
  .chips li {
    border: 1px solid color-mix(in srgb, var(--color-ink) 20%, transparent);
    border-radius: 9999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
  }

  @media (min-width: 720px) {
    .group {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
    }
  }
</style>
